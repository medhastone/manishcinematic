# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Used for server-side Razorpay order creation & HMAC signature verification.
RAZORPAY_KEY_ID="rzp_test_manish_cinematic"
RAZORPAY_KEY_SECRET="manish_cinematic_webhook_secret_key"

# GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform API key for Maps Embed API.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# STUDIO_BOOKING_EMAIL: Studio inbox that receives free booking notification emails (defaults to manishcinematic821005@gmail.com).
STUDIO_BOOKING_EMAIL="manishcinematic821005@gmail.com"

# WEB3FORMS_ACCESS_KEY: Optional free Web3Forms key (if omitted, uses zero-key free FormSubmit service).
WEB3FORMS_ACCESS_KEY=""
